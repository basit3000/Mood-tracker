# MongoDB (docker-compose `mongo` service)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_DB=moodtracker
MONGO_PORT=27017

# Spring Boot app (docker-compose `app` service)
# Host port mapped to container 8080; also passed as SERVER_PORT inside the container
SPRING_DATA_SERVER_PORT=8080

# Must use Compose service hostname `mongo` when running via docker compose
SPRING_DATA_MONGODB_URI=mongodb://root:changeme@mongo:27017/moodtracker?authSource=admin
